rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isInstitutionalIssuer(institutionId) {
      return isSignedIn() && (
        (request.auth.token.role == 'INSTITUTIONAL_ISSUER' && request.auth.token.institutionId == institutionId) ||
        request.auth.token.role == 'SYSTEM_ADMIN'
      );
    }

    // Media files stored at: media/institutions/{institutionId}/{fileName}
    match /media/institutions/{institutionId}/{fileName} {
      // Public can read uploaded official files if verified
      allow read: if true;

      // Only authorized institutional issuers of that institution or system admins can write
      // Enforce file size limit (e.g. max 100MB) and valid content types (audio, video, pdf, document)
      allow write: if isInstitutionalIssuer(institutionId)
        && request.resource.size < 100 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('text/.*') ||
          request.resource.contentType.matches('application/.*')
        );
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
